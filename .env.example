# ------------------------------------------------------------
# AI-Powered News Aggregator - Environment Configuration
# ------------------------------------------------------------

# Application Environment & Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL / Supabase / Local PostgreSQL)
# Example for local PostgreSQL: postgresql://postgres:postgres@localhost:5432/news_aggregator
# Example for Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/news_aggregator?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/news_aggregator?schema=public"

# Redis Cache Configuration
# Can be disabled for local development without breaking functionality: ENABLE_REDIS=false
REDIS_URL="redis://localhost:6379"
ENABLE_REDIS=false
REDIS_CACHE_TTL_SECONDS=900

# Supabase Authentication & Managed Services (Optional in local dev mode)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# External News Provider APIs (Optional: RSS & Mock providers work out of the box without keys)
NEWS_API_KEY=""
GNEWS_API_KEY=""
ENABLE_MOCK_FALLBACK=true

# Python NLP Service
NLP_SERVICE_URL="http://localhost:8000"
NLP_MODEL_NAME="distilbert/distilbert-base-uncased-finetuned-sst-2-english"
NLP_TIMEOUT_MS=8000

# Ingestion Scheduling
INGESTION_INTERVAL_MINUTES=30
